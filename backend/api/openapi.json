  "components": {
    "schemas": {
      "ScopeScoreCategory": {
        "type": "object",
        "required": ["category", "weight", "score", "penalty", "findings"],
        "properties": {
          "category": { "type": "string" },
          "weight": { "type": "integer" },
          "score": { "type": "integer" },
          "penalty": { "type": "integer" },
          "findings": { "type": "integer" }
        }
      },
      "ScopeScore": {
