{$AUDITOR_DOMAIN:localhost} {
	encode gzip

	# /metrics stays on the API's internal port and is not published here.

	handle /health {
		reverse_proxy api:8080
	}

	handle /ready {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
