# Copy to the repository root as .env.prod. Never commit that copy.
#   podman compose -f deploy/compose.prod.yaml --env-file .env.prod up -d
#
# The compose file fails closed when POSTGRES_PASSWORD, AUDITOR_BOOTSTRAP_USER,
# AUDITOR_BOOTSTRAP_PASSWORD, AUDITOR_CORS_ORIGINS or AUDITOR_TARGET_ALLOWED_HOSTS
# are empty. Target slots travel via env_file; do not put them in the YAML.

POSTGRES_DB=db_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=

AUDITOR_BOOTSTRAP_USER=admin
AUDITOR_BOOTSTRAP_PASSWORD=

AUDITOR_CORS_ORIGINS=https://auditor.example.com
AUDITOR_TARGET_ALLOWED_HOSTS=tiger.example.com,dc.example.com

AUDITOR_TARGET_1_ENVIRONMENT_ID=
AUDITOR_TARGET_1_HOST=
AUDITOR_TARGET_1_PORT=5432
AUDITOR_TARGET_1_DATABASE=
AUDITOR_TARGET_1_USER=
AUDITOR_TARGET_1_PASSWORD=
AUDITOR_TARGET_1_SSLMODE=verify-full

AUDITOR_TARGET_2_ENVIRONMENT_ID=
AUDITOR_TARGET_2_HOST=
AUDITOR_TARGET_2_PORT=5432
AUDITOR_TARGET_2_DATABASE=
AUDITOR_TARGET_2_USER=
AUDITOR_TARGET_2_PASSWORD=
AUDITOR_TARGET_2_SSLMODE=verify-full
