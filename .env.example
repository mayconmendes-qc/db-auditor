# Copy to .env and use a locally generated development password.
# Never commit real credentials.
#
# Host requirements: Podman (or Docker) + Compose only.
# Languages and tools run inside containers via `make`.

# --- Snapshot store (Postgres do próprio Auditor) ---------------------------
POSTGRES_DB=timescale_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=change-me-locally

AUDITOR_HTTP_PORT=8080
AUDITOR_STATEMENT_TIMEOUT=15s
AUDITOR_LOCK_TIMEOUT=5s

# Logging: json (default) or text; level debug|info|warn|error
# AUDITOR_LOG_FORMAT=json
# AUDITOR_LOG_LEVEL=info

# CORS: comma-separated browser origins allowed to call the API.
# Empty = localhost:5173 / 5174 (dev). Production: set your UI origin(s).
# AUDITOR_CORS_ORIGINS=http://localhost:5173,https://auditor.example.com

# Escopo de coleta (lista separada por vírgula).
# Allowlist vazia = todos os nomes não negados. Denylist sempre vence.
AUDITOR_DATABASE_DENYLIST=template0,template1,postgres
AUDITOR_SCHEMA_DENYLIST=pg_catalog,information_schema
# AUDITOR_DATABASE_ALLOWLIST=
# AUDITOR_SCHEMA_ALLOWLIST=

# --- Ambientes auditados (somente leitura) ---------------------------------
# Credenciais discretas por slot (mesmo estilo do POSTGRES_* acima).
# ENVIRONMENT_ID deve bater com o UUID do ambiente na UI (seed demo abaixo).
# Após alterar: make down && make up
#
# Slot 1 — Demo Tiger Cloud (seed: 00000000-0000-0000-0000-000000000001)
AUDITOR_TARGET_1_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000001
AUDITOR_TARGET_1_HOST=
AUDITOR_TARGET_1_PORT=5432
AUDITOR_TARGET_1_DATABASE=
AUDITOR_TARGET_1_USER=
AUDITOR_TARGET_1_PASSWORD=
AUDITOR_TARGET_1_SSLMODE=require

# Slot 2 — Demo Datacenter (seed: 00000000-0000-0000-0000-000000000002)
AUDITOR_TARGET_2_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000002
AUDITOR_TARGET_2_HOST=
AUDITOR_TARGET_2_PORT=5432
AUDITOR_TARGET_2_DATABASE=
AUDITOR_TARGET_2_USER=
AUDITOR_TARGET_2_PASSWORD=
AUDITOR_TARGET_2_SSLMODE=require

# Slots 3..20 seguem o mesmo padrão (AUDITOR_TARGET_N_*).
# Fallback legado (URI completa), se preferir:
# AUDITOR_TARGET_DSN_00000000_0000_0000_0000_000000000001=postgresql://user:pass@host:5432/db?sslmode=require

# Frontend host port (container always listens on 5173).
# If you see "bind: address already in use", pick a free port, e.g. 5174.
FRONTEND_HTTP_PORT=5173
# Browser → API. Cross-origin requires CORS on the API (enabled by default for localhost).
VITE_API_BASE_URL=http://localhost:8080
